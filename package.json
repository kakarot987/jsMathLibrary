{
  "name": "@mdevrani/my-js-lib",
  "version": "1.0.1",
  "description": "A tiny math utility library",
  "type": "module",
  "main": "./dist/mathUtils.cjs",
  "module": "./dist/mathUtils.esm.js",
  "exports": {
    ".": {
      "import": "./dist/mathUtils.esm.js",
      "require": "./dist/mathUtils.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "math",
    "utils",
    "library"
  ],
  "author": "Mayank",
  "license": "MIT",
  "devDependencies": {
    "jest": "^29.7.0",
    "rollup": "^4.39.0"
  }
}
